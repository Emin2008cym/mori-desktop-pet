{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mori",
  "version": "0.1.0",
  "identifier": "local.mori.desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && npm run package:backend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mori · Personal AI",
        "width": 1360,
        "height": 900,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:4179 http://127.0.0.1:4180 http://127.0.0.1:4181 http://127.0.0.1:4182 http://127.0.0.1:4183 http://127.0.0.1:4184 http://127.0.0.1:4185 http://127.0.0.1:4186 http://127.0.0.1:4187 http://127.0.0.1:4188 http://127.0.0.1:4189 http://127.0.0.1:4190 http://127.0.0.1:4191 http://127.0.0.1:4192 http://127.0.0.1:4193 http://127.0.0.1:4194"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "resources/server": "server",
      "resources/node_modules": "node_modules",
      "resources/package.json": "package.json",
      "resources/binaries/*": "binaries/"
    },
    "windows": { "nsis": { "displayLanguageSelector": false } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
